# MINDSTEP — environment configuration (local mode)
# Copy to .env.local and edit. The app RUNS with no environment variables at
# all; everything here is optional hardening or documented upgrade path.

# ── Data location (local mode) ────────────────────────────────
# Directory for the file-backed JSON store. Defaults to ./data.
MINDSTEP_DATA_DIR=./data

# ── Production persistence (documented upgrade path) ─────────
# Setting BOTH values switches the persistence adapter to Supabase.
# IMPORTANT: until these are real, verified credentials, do not claim
# cloud persistence anywhere in product copy. See docs/architecture.md.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
